\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \small  Failure case: inside a concave (horseshoe) obstacle, the repulsive gradient from the near wall exactly balances the attractive pull toward $q_{goal}$ (cf.\ book Fig.\ 4.10).}}{7}{figure.9}\protected@file@percent }
