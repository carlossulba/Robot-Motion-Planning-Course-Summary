\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces \small  Global localization in a hallway with 3 doors: the belief starts uniform; sensing a door splits it into 3 equally-likely peaks; moving right predicts-forward and flattens each peak slightly; sensing a second door reinforces only the peak consistent with \emph  {both} sightings, leaving the robot confident of its true location --- prediction spreads the belief out, update sharpens it (cf.\ book Fig.\ 9.1).}}{18}{figure.27}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.2}Representing the Belief}{18}{subsection.10.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces \small  Global localization with a grid: the belief (dark = likely) starts smeared at (A), narrows at (B), and pins down a unique peak at (C) (cf.\ book Fig.\ 9.4) .}}{18}{figure.28}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {29}{\ignorespaces \small  Global localization with a particle filter (10{,}000 samples): particles start spread uniformly over free space (left), thin out and cluster after fusing 10 sensor readings (middle), and collapse onto the true pose after 65 steps (right) --- resampling is what drives this convergence (cf.\ book Fig.\ 9.7).}}{19}{figure.29}\protected@file@percent }
